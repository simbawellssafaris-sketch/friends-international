# Copy this file to .env and fill in your Supabase project values (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-side email (Hostinger SMTP). Server-only: never prefix these with NEXT_PUBLIC_.
# Set the real values in the Hostinger Node.js app environment settings (and .env.local for local testing).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mailbox@yourdomain.com
SMTP_PASS=
MAIL_FROM="Friends International Website" <your-mailbox@yourdomain.com>
MAIL_TO=info@yourdomain.com

# Admin area
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Server-only secret key (Supabase > Project Settings > API Keys > Secret keys). Never prefix with NEXT_PUBLIC. Used from Stage 4.
SUPABASE_SECRET_KEY=
